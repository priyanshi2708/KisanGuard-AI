# KisanGuard AI - Server Environment Configuration
# Database Connection (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/kisanguard

# Authentication Secret (JWT) - keep strictly server-side
JWT_SECRET=your_jwt_super_secret_production_key_here

# GROQ API Key (Keep strictly server-side, NEVER prefix with VITE_)
GROQ_API_KEY=

# Configurable Groq Models
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Server & Network Configuration
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Email Provider Configuration (Optional - for registration welcome emails)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM="KisanGuard AI" <no-reply@yourdomain.com>
EMAIL_SECURE=false

# Optional: Frontend API URL if frontend is hosted on a separate domain/origin (e.g., https://api.kisanguard.com)
VITE_API_BASE_URL=
